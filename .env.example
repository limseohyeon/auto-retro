# 이 파일은 프로젝트 실행에 필요한 환경변수 목록을 공유하기 위한 문서입니다.
# 실제 비밀번호와 API Key는 작성하거나 Git에 커밋하지 않습니다.
# Spring Boot는 이 파일을 자동으로 읽지 않으므로 IntelliJ 실행 설정,
# PowerShell 또는 배포 환경에 실제 값을 등록해야 합니다.

# 실행할 Spring Profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://localhost:5432/auto_retro
DB_USERNAME=auto_retro
DB_PASSWORD=

# Spring AI OpenAI 연동 시 사용합니다.
# 현재 application-local.yml에서 관련 설정이 비활성화되어 있으므로 아직 필수는 아닙니다.
# OPENAI_API_KEY=
